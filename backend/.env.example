# Copy this file to .env and fill in your real values. .env is already in .gitignore.

# Postgres connection string. Adjust user/password/host/port/dbname for your setup.
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/secondbrain

# Where Chroma stores its on-disk vector index.
CHROMA_DIR=vector_db

# Get a free/paid key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# Set to "true" to log every SQL statement (noisy - dev only)
SQL_ECHO=false
