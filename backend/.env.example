# Copy this file to .env and fill in your real values. .env is already in .gitignore.

# Postgres connection string. Adjust user/password/host/port/dbname for your setup.
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/secondbrain

# Where Chroma stores its on-disk vector index.
CHROMA_DIR=vector_db

# Get a free/paid key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: OpenRouter model for summaries, flashcards and search answers.
# Leave unset for the default (openai/gpt-4o-mini). A ":free" model works
# for testing without credits. Restart the backend after changing it.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: OpenRouter vision model for text recognition (OCR) of scanned PDF
# pages and uploaded images. It must accept images. Leave unset for the default
# (google/gemma-4-31b-it:free). Restart the backend after changing it.
# OCR_MODEL=google/gemma-4-31b-it:free

# Set to "true" to log every SQL statement (noisy - dev only)
SQL_ECHO=false

# Accounts. Set ALLOW_SIGNUP=false to close sign-up once your account exists
# (existing accounts still log in). Set SESSION_COOKIE_SECURE=true when the
# app is served over HTTPS; leave it off for http://localhost.
# ALLOW_SIGNUP=false
# SESSION_COOKIE_SECURE=true

# Password reset emails through Brevo (free: 300 emails a day, no domain needed).
# Without BREVO_API_KEY, reset links are written to the backend log instead.
# EMAIL_FROM must be a sender verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=SecondBrain
# APP_BASE_URL=http://localhost:5173
# PASSWORD_RESET_MINUTES=30

# Long summaries. MERGED_MAX_CHARS: the most text a merged set can hold (default 300000).
# MERGED_MAX_DOC_CHARS: the most text one document in a new merged set can have (default 100000;
# the frontend marks documents over the default).
# SUMMARY_PARALLEL_CALLS: AI calls a long summary runs at once (default 4; lower it on rate limits).
# MERGED_MAX_CHARS=300000
# MERGED_MAX_DOC_CHARS=100000
# SUMMARY_PARALLEL_CALLS=4
